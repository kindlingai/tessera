#!/bin/sh
# Formatting, then style, lint and simcheck through stickler,
# then clippy on the crates that hold staged files.
# stickler runs style first and stops at the first failure.
# Style and simcheck run when `tools/scripts/stickler.sh fetch`
# has put their models in ~/.cache/tessera/check.
# Install: tools/scripts/install-hooks.sh
. "$(dirname "$0")/worktree.sh"
set -e
tools/scripts/fmt-check.sh --all
tools/scripts/stickler.sh run --staged
tools/scripts/clippy-staged.sh
