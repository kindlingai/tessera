{
  "fields": {
    "content": {
      "close": [
        "<|observation|>",
        "<|user|>",
        "<|endoftext|>"
      ]
    },
    "thinking": {
      "open": "<think>",
      "close": "</think>"
    },
    "tool_calls": {
      "open_pattern": "<tool_call>\\s*(?P<name>[^<\\s]+)",
      "close": "</tool_call>",
      "content": "tags",
      "content_args": {
        "pattern": "<arg_key>(?P<key>[\\s\\S]*?)</arg_key>\\s*<arg_value>(?P<value>[\\s\\S]*?)</arg_value>"
      },
      "transform": {
        "type": "function",
        "function": {
          "name": "{name}",
          "arguments": "{content}"
        }
      }
    }
  }
}
