{
  "fields": {
    "content": {"close": "<|im_end|>", "content": "text"},
    "thinking": {"open": "<think>\n", "close": "</think>", "content": "text"},
    "tool_calls": {
      "open_pattern": "<tool_call>\\s*<function=(?P<name>[^>\\n]+)>",
      "close": "</tool_call>",
      "content": "tags",
      "content_args": {"pattern": "(?s)<parameter=(?P<key>[^>\\n]+)>\\n?(?P<value>.*?)\\n?</parameter>"},
      "transform": {"type": "function", "function": {"name": "{name}", "arguments": "{content}"}}
    }
  }
}
